from itertools import permutations

cost = [[3, 10, 7],
	[8, 5, 12],
	[4, 6, 9]]

best_cost = float('inf')

for p in permutations(range(3)):
    total = sum(cost[i][p[i]] for i in range(3))

    if total < best_cost:
	best_cost = total
	best = p

print("Assignment:", best)
print("Minimum Cost:", best_cost)
