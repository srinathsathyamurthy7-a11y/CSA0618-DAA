import math

points = [(1, 2), (4, 5), (7, 8), (3, 1)]
min_dist = float('inf')

for i in range(len(points)):
	for j in range(i + 1, len(points)):
		x1, y1 = points[i]
		x2, y2 = points[j]

		d = math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2)

		if d < min_dist:
			min_dist = d
			pair = (points[i], points[j])

print("Closest Pair:", pair)
print("Minimum Distance:", round(min_dist, 4))
