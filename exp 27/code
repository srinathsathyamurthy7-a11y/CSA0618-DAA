from itertools import permutations
import math

points = [(1, 2), (4, 5), (7, 1), (3, 6)]

min_dist = float('inf')

for p in permutations(points[1:]):
	path = [points[0]] + list(p) + [points[0]]
	dist = 0

	for i in range(len(path) - 1):
		x1, y1 = path[i]
		x2, y2 = path[i + 1]
		dist += math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2)

	if dist < min_dist:
		min_dist = dist
		best_path = path

print("Shortest Path:", best_path)
print("Shortest Distance:", round(min_dist, 4))
